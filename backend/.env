# ====================================================
# 树洞系统 - 后端环境变量
# 注意：本文件含本机敏感配置，已加入 .gitignore，不会提交
# 模板文件请看同目录的 .env.example
# ====================================================

APP_NAME=TreeHollow
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/tree_hollow?charset=utf8mb4

REDIS_URL=redis://127.0.0.1:6379/0

JWT_SECRET=tree-hollow-super-secret-key-change-me
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=10080

# ⚠️ 必填！DeepSeek API Key
# 申请地址：https://platform.deepseek.com → API Keys → 创建
# 示例格式：DEEPSEEK_API_KEY=sk-1234567890abcdef1234567890abcdef
# ↓↓↓ 把下面这行的占位文本替换为你的真实 key ↓↓↓
DEEPSEEK_API_KEY=sk-592332944ffe408ba27abac9517909a0

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

AI_CONTEXT_WINDOW=20
AI_CACHE_FILE=./data/ai_cache.json
