# ====================================================
# 树洞系统 - 后端环境变量配置
# 复制本文件为 .env 后再修改（已有 .env 直接编辑即可）
# ====================================================

# ---------- 应用基础 ----------
APP_NAME=TreeHollow
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# ---------- MySQL ----------
# 格式：mysql+pymysql://用户名:密码@主机:端口/库名?charset=utf8mb4
# 本地默认 root 无密码，密码留空即可
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/tree_hollow?charset=utf8mb4

# ---------- Redis ----------
# 默认本地 6379 / DB 0
REDIS_URL=redis://127.0.0.1:6379/0

# ---------- JWT 鉴权 ----------
# 任意长随机字符串，生产环境请务必修改
# 生成示例：openssl rand -base64 48
JWT_SECRET=tree-hollow-super-secret-key-change-me
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=10080

# ---------- DeepSeek AI（必填，否则 AI 聊天不可用）----------
# 1. 打开 https://platform.deepseek.com 注册账号
# 2. 进入 "API Keys" 页面 → 点 "创建 API Key"
# 3. 复制生成的 sk- 开头的密钥，粘贴到下方 = 后面（不要加引号、不要有空格）
#
# 示例（这是占位样例，请替换为你自己的真实 key）：
#   DEEPSEEK_API_KEY=sk-1234567890abcdef1234567890abcdef
DEEPSEEK_API_KEY=请把这里替换为你的真实-sk-开头-key

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- AI 对话上下文 ----------
# 进程内缓存最近 N 轮消息，超过后裁掉最旧的（数据库永久保留）
AI_CONTEXT_WINDOW=20
# 进程重启时从此文件懒加载会话上下文
AI_CACHE_FILE=./data/ai_cache.json

# ---------- RAG 向量检索 ----------
# 兜底使用本地 hash embedding，无需外部 key 也能跑
# 如果想用更强的 embedding（推荐 SiliconFlow，国内免费且兼容 OpenAI 协议），
# 注释中的 3 行去掉 # 并填入真实值即可
#
# EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=sk-你的-siliconflow-key
# EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# EMBEDDING_DIM=1024
